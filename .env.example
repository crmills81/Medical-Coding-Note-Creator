# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-key-here

# Optional overrides
# gemini-3.1-pro-preview gives the highest accuracy for numeric/coding recall.
# gemini-3.1-flash-lite is faster/cheaper if you're comfortable trading some precision for speed.
GEMINI_MODEL=gemini-3.1-pro-preview
PORT=3000
